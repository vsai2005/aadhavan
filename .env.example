# ─── PRODUCTION ENV VARS ────────────────────────────────────────────────────
# Copy this to `.env` for local testing. On Railway, set these in the
# project's Variables tab — DO NOT commit .env to git.

# Set to 'production' on Railway. Locally, leave unset (dev mode).
FLASK_ENV=production

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never change this in production or everyone gets logged out.
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# On Railway, this points at the mounted volume (see DEPLOY.md).
# Leave blank locally to use ./data/aadhavan.db
DATABASE_URL=

# Public URL where the site is reachable. Used in email notification links.
PUBLIC_SITE_URL=https://aadhavanevents.in

# ─── Notifications (Resend) ─────────────────────────────────────────────────
# Get a free API key at resend.com → 3000 emails/month free.
# You MUST verify a domain first (see DEPLOY.md step 2).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an email on a domain you verified in Resend.
RESEND_FROM_EMAIL=notifications@aadhavanevents.in

# Where new-inquiry alerts go — your sister's inbox.
OWNER_NOTIFICATION_EMAIL=your.sister@gmail.com

# ─── Seed credentials (first run only) ──────────────────────────────────────
# Change these BEFORE running seed.py for the first time in prod.
SEED_ADMIN_EMAIL=owner@aadhavanevents.in
SEED_ADMIN_PASSWORD=please-change-this-to-a-long-random-password

# ─── Gunicorn tuning (optional) ─────────────────────────────────────────────
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# LOG_LEVEL=info
